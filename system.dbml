}
Ref: "mimic_map_map"."id_map_origin" > "mimic_maps"."id"
Ref: "mimic_map_map"."id_map_destination" > "mimic_maps"."id"

Table mimic_map_token {
  id uuid [primary key, not null]
  id_sheet uuid
  id_map uuid [not null]
  position_a integer [not null]
  position_b integer [not null]
  position_c integer [not null]
  size_a integer [not null]
  size_b integer [not null]
  size_c integer [not null]
  origin_a integer [not null]
  origin_b integer [not null]
  origin_c integer [not null]
  angle_a integer [not null] /*0-360*/
  angle_b integer [not null] /*0-360*/
  angle_c integer [not null] /*0-360*/
  solid_level integer [not null]
}
Ref: "mimic_map_token"."id" > "mimic_entities"."id"
Ref: "mimic_map_token"."id_sheet" > "mimic_sheets"."id"
Ref: "mimic_map_token"."id_map" > "mimic_maps"."id"


}
Ref: "mimic_sheet_type_generator_type"."id_sheet_type" > "mimic_sheet_types"."id"
Ref: "mimic_sheet_type_generator_type"."id_generator_type" > "mimic_generator_types"."id"

Table mimic_action_types {
  id uuid [primary key, not null]
  name varchar [not null]
  id_validation_rule uuid [not null]
}
Ref: "mimic_action_types"."id" > "mimic_entities"."id"
Ref: "mimic_action_types"."id_validation_rule" > "mimic_rules"."id"

Table mimic_actions {
  id uuid [primary key, not null]
  id_action_type uuid [not null]
  name varchar [not null]
  id_action_rule uuid [not null]
}
Ref: "mimic_actions"."id" > "mimic_entities"."id"
Ref: "mimic_actions"."id_action_type" > "mimic_action_types"."id"
Ref: "mimic_actions"."id_action_rule" > "mimic_rules"."id"

Table mimic_action_type_generator_type {
  id_action_type uuid [primary key, not null]
  id_generator_type uuid [primary key, not null]
}
Ref: "mimic_action_type_generator_type"."id_action_type" > "mimic_action_types"."id"
Ref: "mimic_action_type_generator_type"."id_generator_type" > "mimic_generator_types"."id"

Table mimic_rules {
  id uuid [primary key, not null]
  name varchar [not null]
  type enum("math", "validation", "action", "relationship", "trigger") [not null]
  is_passive boolean [default: false]
  id_trigger_rule uuid
  rule jsonb [not null] /*ast*/
}
Ref: "mimic_rules"."id" > "mimic_entities"."id"
Ref: "mimic_rules"."id_trigger_rule" > "mimic_rules"."id"

Table mimic_rule_entity {
  id uuid [primary key, not null]
  id_rule uuid [not null]
  id_entity uuid [not null]
  resolve_method enum("manual", "context") [not null]
  value_type uuid [not null]
  internal_name varchar [not null]
}
Ref: "mimic_rule_entity"."id_rule" > "mimic_rules"."id"
Ref: "mimic_rule_entity"."id_entity" > "mimic_entities"."id"
Ref: "mimic_rule_entity"."value_type" > "mimic_value_types"."id"

Table mimic_rngs {
  id uuid [primary key, not null]
  name varchar [not null]
  id_filter_rule uuid
  expected_value integer
  num_start integer
  num_end integer
  num_step integer
  final_values integer[] [not null]
  type enum("other", "dice", "deck", "spinner") [not null]
}
Ref: "mimic_rngs"."id" > "mimic_entities"."id"
Ref: "mimic_rngs"."id_filter_rule" > "mimic_rules"."id"

Table mimic_value_types {
  id uuid [primary key, not null]
  value_type enum("number", "string", "boolean", "entity") [not null]
  struct_type enum("value", "list", "consumable", "enum", "key_value") [not null]
}

Table mimic_attributes {
  id uuid [primary key, not null]
  id_value_rule uuid [not null]
  name varchar [not null]
  value_type uuid [not null]
  expected_value_number number
  expected_value_string varchar
  expected_value_boolean boolean
  expected_value_entity uuid
  default_value_number number
  default_value_string varchar
  default_value_boolean boolean
  default_value_entity uuid
  is_composable boolean [default: true]
  is_constant boolean [default: false]
  min_size_value integer
  max_size_value integer
}
Ref: "mimic_attributes"."id" > "mimic_entities"."id"
Ref: "mimic_attributes"."id_value_rule" > "mimic_rules"."id"
Ref: "mimic_attributes"."value_type" > "mimic_value_types"."id"
Ref: "mimic_attributes"."expected_value_entity" > "mimic_entities"."id"
Ref: "mimic_attributes"."default_value_entity" > "mimic_entities"."id"

Table mimic_entity_attribute {
  id uuid [primary key, not null]
  id_entity uuid [not null]
  id_attribute uuid [not null]
}
Ref: "mimic_entity_attribute"."id_entity" > "mimic_entities"."id"
Ref: "mimic_entity_attribute"."id_attribute" > "mimic_attributes"."id"

Table mimic_entity_attribute_entry {
  id uuid [primary key, not null]
  id_entity_attribute uuid [not null]
  attribute_number number
  attribute_string varchar
  attribute_boolean boolean
  attribute_entity uuid
  order integer [default: 1]
}
Ref: "mimic_entity_attribute_entry"."id_entity_attribute" > "mimic_entity_attribute"."id"
Ref: "mimic_entity_attribute_entry"."attribute_entity" > "mimic_entities"."id"


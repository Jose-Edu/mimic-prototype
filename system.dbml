}
Ref: "mimic_test_types"."id" > "mimic_entities"."id"
Ref: "mimic_test_types"."id_default_rule" > "mimic_rules"."id"

Table mimic_tests {
  id uuid [primary key, not null]
  id_test_type uuid [not null]
  id_rule uuid
  name varchar [not null]
}
Ref: "mimic_tests"."id" > "mimic_entities"."id"
Ref: "mimic_tests"."id_test_type" > "mimic_test_types"."id"
Ref: "mimic_tests"."id_rule" > "mimic_rules"."id"

Table mimic_test_rng {
  id_test uuid [primary key, not null]
  id_rng uuid [primary key, not null]
}
Ref: "mimic_test_rng"."id_test" > "mimic_tests"."id"
Ref: "mimic_test_rng"."id_rng" > "mimic_rngs"."id"

Table mimic_game_states {
  id uuid [primary key, not null]
  name varchar [not null]
  turn_count_by_sheet_type_rule_id uuid [not null]
  turn_filter_rule_id uuid [not null]
  turn_order_rule_id uuid [not null]
}
Ref: "mimic_game_states"."id" > "mimic_entities"."id"
Ref: "mimic_game_states"."turn_count_by_sheet_type_rule_id" > "mimic_rules"."id"
Ref: "mimic_game_states"."turn_filter_rule_id" > "mimic_rules"."id"
Ref: "mimic_game_states"."turn_order_rule_id" > "mimic_rules"."id"

Table mimic_systems {
  id uuid [primary key, not null]
  mimic_version varchar [not null]
  name varchar [not null]
  system_version varchar [not null]
  id_author_user uuid [not null]
  system_hash varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
  type enum("root", "delta") [not null]
  category enum("other", "draft", "full system", "adventure", "engine", "scenario", "expansion", "variant", "extra_rule_set") [not null]
  play_minutes_expected integer
  session_number_expected integer
  players_count_expected integer
  id_delta_origin uuid
  actual_game_state uuid [not null]
}
Ref: "mimic_systems"."id_delta_origin" > "mimic_systems"."id"
Ref: "mimic_systems"."id_author_user" > "mimic_users"."id"
Ref: "mimic_systems"."actual_game_state" > "mimic_game_states"."id"

Table mimic_actual_turn_members {
  id_system uuid [primary key, not null]
  id_sheet uuid [primary key, not null]
}
Ref: "mimic_actual_turn_members"."id_system" > "mimic_systems"."id"
Ref: "mimic_actual_turn_members"."id_sheet" > "mimic_sheets"."id"

Table mimic_event_logs {
  id uuid [primary key, not null]
  created_at timestamp [not null]
  id_entity uuid [not null]
  event_type enum("free", "narrative" ,"mimic") [not null]
  mimic_event enum("read", "use", "update", "create", "delete", "overwrite")
  narrative_event enum("other", "dialog", "action", "narration")
  entry text [not null]
  multi_part_id uuid
  resolved boolean [not null]
}
Ref: "mimic_event_logs"."id_entity" > "mimic_entities"."id"

Table mimic_tags {
  id uuid [primary key, not null]
  id_system uuid [not null]
  name varchar [not null]
}
Ref: "mimic_tags"."id_system" > "mimic_systems"."id"

Table mimic_tag_entity {
  id_tag uuid [primary key, not null]
  id_entity uuid [primary key, not null]
}
Ref: "mimic_tag_entity"."id_tag" > "mimic_tags"."id"
Ref: "mimic_tag_entity"."id_entity" > "mimic_entities"."id"

Table mimic_entities {
  id uuid [primary key, not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  id_system uuid [not null]
  id_creator_user uuid [not null]
  emphasis_level enum("hidden", "common", "featured") [not null]
  id_overrides_entity uuid
  table_name varchar [not null] /*ex: generators, rules, roles etc*/
  is_active boolean [default: true]
  expected_uses_by_session integer
}
Ref: "mimic_entities"."id_overrides_entity" > "mimic_entities"."id"
Ref: "mimic_entities"."id_creator_user" > "mimic_users"."id"
Ref: "mimic_entities"."id_system" > "mimic_systems"."id"


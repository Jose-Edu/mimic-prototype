}
Ref: "mimic_sheet_group_sheet"."id_sheet_group" > "mimic_sheet_groups"."id"
Ref: "mimic_sheet_group_sheet"."id_sheet" > "mimic_sheets"."id"

Table mimic_generator_types {
  id uuid [primary key, not null]
  name varchar [not null]
  id_validation_rule uuid [not null]
  id_compose_rule uuid [not null]
}
Ref: "mimic_generator_types"."id" > "mimic_entities"."id"
Ref: "mimic_generator_types"."id_validation_rule" > "mimic_rules"."id"

Ref: "mimic_sheet_types"."id_validation_rule" > "mimic_rules"."id"
Ref: "mimic_sheet_types"."id_compose_rule" > "mimic_rules"."id"
Ref: "mimic_sheet_types"."id_base_generator" > "mimic_generators"."id"
Ref: "mimic_sheet_types"."id_default_group" > "mimic_sheet_groups"."id"


Table mimic_migrations {
  id uuid [primary key, not null]
  id_system uuid [not null]
  mimic_version varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  migration_name varchar [not null]
  resolved boolean [default: false]
  new_system_version varchar
}
Ref: "mimic_migrations"."id_system" > "mimic_systems"."id"

Table mimic_users {
  id uuid [primary key, not null]
  name varchar [not null]
}

Table mimic_user_system {
  id_user uuid [primary key, not null]
  id_system uuid [primary key, not null]
}
Ref: "mimic_user_system"."id_user" > "mimic_users"."id"
Ref: "mimic_user_system"."id_system" > "mimic_systems"."id"

Table mimic_user_role {
  id_user uuid [primary key, not null]
  id_role uuid [primary key, not null]
}
Ref: "mimic_user_role"."id_user" > "mimic_users"."id"
Ref: "mimic_user_role"."id_role" > "mimic_roles"."id"

Table mimic_user_access {
  id_user uuid [primary key, not null]
  id_access uuid [primary key, not null]
}
Ref: "mimic_user_access"."id_user" > "mimic_users"."id"
Ref: "mimic_user_access"."id_access" > "mimic_access"."id"

Table mimic_roles {
  id uuid [primary key, not null]
  name varchar [not null]
  is_default boolean [not null]
  roleless_add boolean [not null]
  category_fit enum("total", "partial") [not null]
  category enum("other", "actor", "master", "admin", "spectator", "open_actor", "tool_manager", "world_owner", "referee") [not null]
}
Ref: "mimic_roles"."id" > "mimic_entities"."id"

Table mimic_access {
  id uuid [primary key, not null]
  id_entity_to_access uuid
  id_game_state uuid
  scope enum("self", "same", "other") [not null]
  can_read boolean [not null]
  can_use boolean [not null]
  can_update boolean [not null]
  can_create boolean [not null]
  can_delete boolean [not null]
  can_overwrite boolean [not null]
}
Ref: "mimic_access"."id_entity_to_access" > "mimic_entities"."id"
Ref: "mimic_access"."id_game_state" > "mimic_game_states"."id"
Ref: "mimic_access"."id" > "mimic_entities"."id"

Table mimic_role_access {
  id_access uuid [primary key, not null]
  id_role uuid [primary key, not null]
}
Ref: "mimic_role_access"."id_role" > "mimic_roles"."id"
Ref: "mimic_role_access"."id_access" > "mimic_access"."id"

Table mimic_sheet_types {
  id uuid [primary key, not null]
  name varchar [not null]
  id_validation_rule uuid [not null]
  id_compose_rule uuid [not null]
